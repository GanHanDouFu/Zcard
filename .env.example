PORT=8080
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 可选：TikHub 抖音视频解析（推荐，速度快，约1.5秒）
# 注册 https://tikhub.io 获取 API Key
TIKHUB_API_KEY=
TIKHUB_API_BASE=https://api.tikhub.dev

# 可选：第三方”视频链接转文字/字幕/转录”API（如 BibiGPT）。
# 后端只把链接传给该 API，不下载视频/音频。
VIDEO_TEXT_API_URL=
VIDEO_TEXT_API_KEY=
VIDEO_TEXT_API_METHOD=POST
VIDEO_TEXT_API_AUTH_HEADER=Authorization
VIDEO_TEXT_API_AUTH_PREFIX=Bearer 
VIDEO_TEXT_API_URL_FIELD=url
VIDEO_TEXT_API_QUERY_FIELD=url
VIDEO_TEXT_API_EXTRA_BODY=
VIDEO_TEXT_API_TIMEOUT_MS=120000
VIDEO_TEXT_API_TEXT_PATHS=transcript,subtitle,text,content,data.transcript,data.subtitle,data.text,data.content,result.transcript,result.subtitle,result.text,result.content
VIDEO_TEXT_API_TITLE_PATHS=title,data.title,result.title

# 可选：Groq Whisper 音频转录（用于没有字幕的视频，免费）
# 注册 https://console.groq.com 获取 API Key
GROQ_API_KEY=

# BibiGPT GET 示例：
# VIDEO_TEXT_API_METHOD=GET
# VIDEO_TEXT_API_URL=https://api.bibigpt.co/api/open/YOUR_API_TOKEN
# VIDEO_TEXT_API_KEY=
# VIDEO_TEXT_API_QUERY_FIELD=url
# VIDEO_TEXT_API_TEXT_PATHS=transcript,subtitle,text,content,summary,detail.transcript,detail.subtitle,detail.text,detail.content,data.transcript,data.subtitle,data.text,data.content,data.summary,result.transcript,result.subtitle,result.text,result.content,result.summary
# VIDEO_TEXT_API_TITLE_PATHS=title,detail.title,data.title,result.title
